# Copy to /data/workspace/one/.env.web and edit before starting the service.
# Instabox public port entry: 0.0.0.0; local Nginx proxy: 127.0.0.1.
ONE_WEB_HOST=127.0.0.1
# Replace with your own HTTPS origin, without a path or trailing slash.
ONE_WEB_PUBLIC_ORIGIN=https://sheeridverify.example.edu
# Generate a unique password. Never use this placeholder in a deployment.
ONE_WEB_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
