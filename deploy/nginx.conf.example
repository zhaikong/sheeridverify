# Replace the domain and certificate paths before enabling this configuration.
# Obtain a valid TLS certificate first; then run nginx -t and reload Nginx.
server {
    listen 80;
    server_name sheeridverify.example.edu;
    return 301 https://sheeridverify.example.edu$request_uri;
}

server {
    listen 443 ssl;
    server_name sheeridverify.example.edu;

    ssl_certificate /etc/letsencrypt/live/sheeridverify.example.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sheeridverify.example.edu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
